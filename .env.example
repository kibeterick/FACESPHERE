# AKIRA AI System - Environment Variables
# Copy this file to .env and add your actual API keys

# Google Gemini AI API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional - for GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud API Key (Optional - for additional services)
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Weather API Key (Optional - for real weather data)
# Get your key from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# Gmail Configuration (for sending real emails)
# Follow GMAIL_SETUP_GUIDE.md for detailed setup instructions
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Payment Gateway Configuration (Optional)
STRIPE_API_KEY=your_stripe_api_key
PAYPAL_CLIENT_ID=your_paypal_client_id
SQUARE_ACCESS_TOKEN=your_square_access_token

# News API Key (Optional - for real news data)
# Get your key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# System Configuration
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Database Configuration
DATABASE_PATH=akira_data.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
